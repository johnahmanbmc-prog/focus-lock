{
  "name": "focus-lock-desktop",
  "productName": "Focus Lock",
  "version": "0.1.0",
  "description": "Desktop app to manage the Focus Lock blocker",
  "main": "main.js",
  "private": true,
  "author": "Focus Lock",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.focuslock.desktop",
    "publish": null,
    "productName": "Focus Lock",
    "files": ["main.js", "preload.js", "core/**", "ui/**", "assets/**"],
    "extraResources": [{ "from": "../extension", "to": "extension" }],
    "win": { "icon": "assets/icon.ico", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "FocusLock-portable-${version}.exe" }
  }
}
