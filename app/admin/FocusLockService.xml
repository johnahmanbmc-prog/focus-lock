<!--
  WinSW configuration for the Focus Lock service. WinSW (FocusLockService.exe,
  https://github.com/winsw/winsw) is downloaded by the build and runs
  "Focus Lock.exe" in Node mode with service.js, as LocalSystem.
  %BASE% is this folder: <install dir>\resources\admin
-->
<service>
  <id>FocusLock</id>
  <name>Focus Lock</name>
  <description>Keeps the Focus Lock settings and serves them to the Focus Lock app and the Chrome and Brave extension.</description>
  <executable>%BASE%\..\..\Focus Lock.exe</executable>
  <arguments>"%BASE%\..\app\service.js"</arguments>
  <env name="ELECTRON_RUN_AS_NODE" value="1"/>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <logpath>%ProgramData%\FocusLock\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
</service>
